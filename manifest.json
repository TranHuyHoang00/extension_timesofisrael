{
  "manifest_version": 3,
  "name": "TimesOfIsrael",
  "version": "1.0.2",
  "description": "Crawl data",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "tabs",
    "scripting",
    "downloads",
    "offscreen",
    "sidePanel"
  ],
  "host_permissions": [
    "https://www.timesofisrael.com/*",
    "https://services-delivery-dev.intelsys.group/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "TimesOfIsrael"
  },
  "minimum_chrome_version": "116"
}
