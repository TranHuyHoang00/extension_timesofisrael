{
  "manifest_version": 3,
  "name": "TimesOfIsrael",
  "version": "1.0.0",
  "description": "Crawl data",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "scripting",
    "downloads",
    "offscreen",
    "sidePanel"
  ],
  "host_permissions": [
    "https://www.timesofisrael.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "TimesOfIsrael"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "minimum_chrome_version": "116"
}