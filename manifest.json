{
  "manifest_version": 3,
  "name": "TimesOfIsrael",
  "version": "0.1.0",
  "description": "Extract data",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "scripting",
    "downloads",
    "offscreen",
    "sidePanel"
  ],
  "host_permissions": [
    "https://www.timesofisrael.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "TimesOfIsrael"
  },
  "minimum_chrome_version": "116"
}